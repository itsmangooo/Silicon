# PostgreSQL used by Silicon itself. Replace every development value in production.
POSTGRES_DB=silicon
POSTGRES_USER=silicon
POSTGRES_PASSWORD=silicon-development-only
DATABASE_URL=postgres://silicon:silicon-development-only@localhost:5432/silicon?sslmode=disable

SILICON_ADDRESS=:8080
SILICON_FRONTEND_ORIGIN=http://localhost:5173
SILICON_SESSION_COOKIE=silicon_session
SILICON_SESSION_TTL=24h
SILICON_COOKIE_SECURE=false
SILICON_AUTO_MIGRATE=true
SILICON_LOG_LEVEL=info
# Base64-encoded 32-byte key used to encrypt provider credentials at rest.
SILICON_ENCRYPTION_KEY=

# GitHub App configuration. Store the PEM with literal newlines or escaped \\n sequences.
SILICON_GITHUB_APP_ID=
SILICON_GITHUB_PRIVATE_KEY=
SILICON_GITHUB_WEBHOOK_SECRET=

# Explicit opt-in for building GitHub Dockerfile sources on this host.
SILICON_LOCAL_DOCKER_ENABLED=false
SILICON_DOCKER_BINARY=docker

# Used only by destructive integration tests. The database name must be silicon_test.
TEST_DATABASE_URL=postgres://silicon:silicon-development-only@localhost:5432/silicon_test?sslmode=disable

# Vite uses a same-origin proxy in development; set this only for a separately hosted API.
VITE_API_URL=
