FROM golang:1.26-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download
COPY backend ./backend
RUN cd backend && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/silicon-updater ./cmd/silicon-updater

FROM docker:28-cli
RUN apk add --no-cache ca-certificates curl docker-cli-compose git
COPY --from=build /out/silicon-updater /usr/local/bin/silicon-updater
ENTRYPOINT ["/usr/local/bin/silicon-updater"]
