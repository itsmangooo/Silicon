FROM golang:1.26-alpine AS build
WORKDIR /src
COPY backend/go.mod backend/go.sum ./backend/
RUN cd backend && go mod download
COPY backend ./backend
RUN cd backend && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/silicon ./cmd/silicon

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/silicon /usr/local/bin/silicon
USER nonroot:nonroot
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=12 CMD ["/usr/local/bin/silicon", "healthcheck"]
ENTRYPOINT ["/usr/local/bin/silicon"]
